+		_UpdateActiveMode();
+		fScreenMode.Get(fOriginal);
+		_CheckApplyEnabled();
+	}
 }
 
 
@@ -1218,6 +1383,14 @@
 			_Apply();
 			break;
 
+		case kMsgUIScaleChanged:
+		{
+			float scale;
+			if (message->FindFloat("scale", &scale) == B_OK)
+				_SetUIScale(scale);
+			break;
+		}
+
 		case MAKE_INITIAL_MSG:
 			// user pressed "keep" in confirmation dialog
 			fModified = true;
@@ -1463,5 +1636,76 @@
 			B_WIDTH_AS_USUAL, B_WARNING_ALERT);
 		alert->SetFlags(alert->Flags() | B_CLOSE_ON_ESCAPE);
 		alert->Go();
+	}
+}
+
+
+/*!	Sets the UI scale - the size of the default fonts, which controls,
+	window borders, icons and the cursor all follow - to \a scale, or to the
+	automatic one for 0.
+*/
+void
+ScreenWindow::_SetUIScale(float scale)
+{
+	const bool automatic = scale <= 0.0f;
+	if (automatic)
+		scale = automatic_ui_scale();
+
+	const float size = roundf(kDefaultFontSize * scale);
+	set_system_font_size("plain", be_plain_font, size);
+	set_system_font_size("bold", be_bold_font, size);
+	set_system_font_size("fixed", be_fixed_font, size);
+
+	menu_info info;
+	if (get_menu_info(&info) == B_OK) {
+		info.font_size = size;
+		set_menu_info(&info);
+	}
+
+	set_ui_scale_automatic(automatic);
+	set_host_scale(automatic ? 1.0f : scale);
+	_MarkUIScale();
+
+	BAlert* alert = new BAlert(B_TRANSLATE("UI scale"),
+		B_TRANSLATE("The new scale applies to applications started from now "
+			"on. Restart Tracker and Deskbar now to apply it to the desktop?"),
+		B_TRANSLATE("Later"), B_TRANSLATE("Restart desktop"));
+	alert->SetShortcut(0, B_ESCAPE);
+	if (alert->Go() == 1)
+		restart_desktop();
+}
+
+
+void
+ScreenWindow::_MarkUIScale()
+{
+	BMenuItem* marked = NULL;
+	if (ui_scale_is_automatic())
+		marked = fUIScaleMenu->ItemAt(0);
+	else {
+		// the menu font size is app_server's current one (be_plain_font
+		// is this application's copy from its start)
+		menu_info info;
+		float size = kDefaultFontSize;
+		if (get_menu_info(&info) == B_OK)
+			size = info.font_size;
+		for (int32 i = 0; BMenuItem* item = fUIScaleMenu->ItemAt(i); i++) {
+			float scale;
+			if (item->Message() != NULL
+				&& item->Message()->FindFloat("scale", &scale) == B_OK
+				&& scale > 0.0f
+				&& roundf(kDefaultFontSize * scale) == size) {
+				marked = item;
+				break;
+			}
+		}
+	}
+
+	if (marked != NULL)
+		marked->SetMarked(true);
+	else {
+		if (BMenuItem* item = fUIScaleMenu->FindMarked())
+			item->SetMarked(false);
+		fUIScaleField->MenuItem()->SetLabel(B_TRANSLATE("Custom"));
 	}
 }
