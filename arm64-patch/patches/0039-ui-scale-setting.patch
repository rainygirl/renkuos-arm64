+/*!	Appearance's "UI scale: Automatic" leaves "auto" in this file: the fonts
+	are then sized by _AutomaticUIScale() on every start, whatever sizes were
+	saved, so the scale follows the display the system is booted on.
+*/
+/*static*/ bool
+Desktop::_UIScaleIsAutomatic()
+{
+	BPath path;
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK
+		|| path.Append("system/app_server/ui_scale") != B_OK)
+		return false;
+
+	BFile file(path.Path(), B_READ_ONLY);
+	char buffer[4];
+	return file.Read(buffer, sizeof(buffer)) == (ssize_t)sizeof(buffer)
+		&& memcmp(buffer, "auto", 4) == 0;
+}
+
