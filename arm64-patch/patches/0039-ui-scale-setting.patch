 #include "multimon.h"	// the usual: DANGER WILL, ROBINSON!
 
 
+extern void _set_system_font_(const char* which, font_family family,
+	font_style style, float size);
+
+
+// #pragma mark - UI scale
+
+
+static const float kDefaultFontSize = 12.0f;
+
+
+/*!	The scale app_server picks when the UI scale is "Automatic": the display's
+	pixel density from its EDID, dpi / 110 in quarter steps from 1 to 3, or the
+	resolution alone without EDID. Keep in step with
+	Desktop::_AutomaticUIScale() in app_server.
+*/
+static float
+automatic_ui_scale()
+{
+	BScreen screen;
+	display_mode mode;
+	if (screen.GetMode(&mode) != B_OK || mode.virtual_width == 0)
+		return 1.0f;
+
+	float scale;
+	monitor_info info;
+	if (screen.GetMonitorInfo(&info) == B_OK && info.width >= 10.0f
+		&& info.width < 400.0f && info.height >= 5.0f) {
+		float dpi = mode.virtual_width / (info.width / 2.54f);
+		scale = roundf(dpi / 110.0f * 4.0f) / 4.0f;
+	} else if (mode.virtual_width >= 3840 && mode.virtual_height >= 2160)
+		scale = 2.0f;
+	else if (mode.virtual_width > 1920 && mode.virtual_height > 1080)
+		scale = 1.5f;
+	else
+		scale = 1.0f;
+
+	return std::max(1.0f, std::min(scale, 3.0f));
+}
+
+
+static status_t
+user_settings_path(BPath& path, const char* leaf)
+{
+	status_t status = find_directory(B_USER_SETTINGS_DIRECTORY, &path);
+	if (status == B_OK)
+		status = path.Append(leaf);
+	return status;
+}
+
+
+/*!	app_server reads this file at startup: "auto" makes it size the fonts by
+	automatic_ui_scale() instead of the saved sizes.
+*/
+static bool
+ui_scale_is_automatic()
+{
+	BPath path;
+	if (user_settings_path(path, "system/app_server/ui_scale") != B_OK)
+		return false;
+
+	BFile file(path.Path(), B_READ_ONLY);
+	char buffer[4];
+	return file.Read(buffer, sizeof(buffer)) == (ssize_t)sizeof(buffer)
+		&& memcmp(buffer, "auto", 4) == 0;
+}
+
+
+static void
+set_ui_scale_automatic(bool automatic)
+{
+	BPath path;
+	if (user_settings_path(path, "system/app_server/ui_scale") != B_OK)
+		return;
+
+	if (!automatic) {
+		BEntry(path.Path()).Remove();
+		return;
+	}
+
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	file.Write("auto\n", 5);
+}
+
+
+/*!	On QEMU's virtio-gpu, rretina_resize (renku-retina) sizes the screen to
+	the host window times this factor; a Retina Mac shows the window in
+	points, so a factor of 2 puts one guest pixel on each physical pixel.
+	The UI scale is used for it, so the desktop keeps its size on the host
+	and gets sharper.
+*/
+static void
+set_host_scale(float scale)
+{
+	BPath path;
+	if (user_settings_path(path, "rretina_resize") != B_OK)
+		return;
+
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	char line[32];
+	int length = snprintf(line, sizeof(line), "host_scale %g\n", scale);
+	file.Write(line, length);
+}
+
+
+static void
+set_system_font_size(const char* which, const BFont* font, float size)
+{
+	font_family family;
+	font_style style;
+	font->GetFamilyAndStyle(&family, &style);
+	_set_system_font_(which, family, style, size);
+}
+
+
+static void
+restart_desktop()
+{
+	// launch_daemon starts them again
+	BMessenger("application/x-vnd.Be-TRAK").SendMessage(B_QUIT_REQUESTED);
+	BMessenger("application/x-vnd.Be-TSKB").SendMessage(B_QUIT_REQUESTED);
+}
+
+
 #undef B_TRANSLATION_CONTEXT
 #define B_TRANSLATION_CONTEXT "Screen"
 
