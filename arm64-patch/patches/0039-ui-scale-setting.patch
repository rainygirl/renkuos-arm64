 	MoveOnScreen();
@@ -1001,6 +1154,18 @@
 		MoveTo((frame.Width() - Frame().Width()) / 2,
 			(frame.Height() - Frame().Height()) / 2);
 	}
+
+	// The mode can change without us: rretina_resize follows the QEMU window
