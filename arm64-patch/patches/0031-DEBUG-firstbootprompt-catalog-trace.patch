Subject: [PATCH] TEMPORARY DEBUG: trace FirstBootPrompt catalog lookup

Not for merging. Writes to /boot/home/fbp-debug.txt (readable from
Terminal after clicking through to the desktop) since stderr from
this job never reaches serial.log or syslog. First round showed
GetAvailableCatalogs() actually succeeds (status=no error, the
"language" field is present) -- so the scan itself is fine. This
round traces the per-language loop (GetLanguage()/GetNativeName()
per entry, and the final list item count) to find where it drops to
zero visible rows. Remove once the real cause is found.

diff --git a/src/apps/firstbootprompt/BootPromptWindow.cpp b/src/apps/firstbootprompt/BootPromptWindow.cpp
index 92f86c5e33..2fd2b88e46 100644
--- a/src/apps/firstbootprompt/BootPromptWindow.cpp
+++ b/src/apps/firstbootprompt/BootPromptWindow.cpp
@@ -12,6 +12,7 @@

 #include <new>
 #include <stdio.h>
+#include <string.h>

 #include <Alert.h>
 #include <Bitmap.h>
@@ -432,8 +433,30 @@ BootPromptWindow::_PopulateLanguages()
 	}

 	BMessage installedCatalogs;
-	BLocaleRoster::Default()->GetAvailableCatalogs(&installedCatalogs,
-		"x-vnd.Haiku-FirstBootPrompt");
+	status_t fbpDebugStatus = BLocaleRoster::Default()->GetAvailableCatalogs(
+		&installedCatalogs, "x-vnd.Haiku-FirstBootPrompt");
+	{
+		FILE* fbpDebugFile = fopen("/boot/home/fbp-debug.txt", "a");
+		if (fbpDebugFile != NULL) {
+			fprintf(fbpDebugFile, "FBP-DEBUG: GetAvailableCatalogs status=%s langCount=%d\n",
+				strerror(fbpDebugStatus), (int)installedCatalogs.CountNames(B_STRING_TYPE));
+
+			BPath fbpDebugPath;
+			status_t fdStatus = find_directory(B_SYSTEM_DATA_DIRECTORY, &fbpDebugPath);
+			fprintf(fbpDebugFile, "FBP-DEBUG: find_directory(B_SYSTEM_DATA_DIRECTORY)=%s path=%s\n",
+				strerror(fdStatus), fbpDebugPath.Path());
+			fbpDebugPath.Append("locale/catalogs/x-vnd.Haiku-FirstBootPrompt");
+			BDirectory fbpDebugDir(fbpDebugPath.Path());
+			fprintf(fbpDebugFile, "FBP-DEBUG: BDirectory(%s).InitCheck=%s\n",
+				fbpDebugPath.Path(), strerror(fbpDebugDir.InitCheck()));
+			int32 fbpDebugCount = 0;
+			BEntry fbpDebugEntry;
+			while (fbpDebugDir.GetNextEntry(&fbpDebugEntry) == B_OK)
+				fbpDebugCount++;
+			fprintf(fbpDebugFile, "FBP-DEBUG: direct scan found %d entries\n", (int)fbpDebugCount);
+			fclose(fbpDebugFile);
+		}
+	}

 	BFont font;
 	fLanguagesListView->GetFont(&font);
@@ -442,15 +465,25 @@ BootPromptWindow::_PopulateLanguages()
 	// for translations of this application. So the list of languages will be
 	// limited to catalogs written for this application, which is on purpose!

+	FILE* fbpDebugFile2 = fopen("/boot/home/fbp-debug.txt", "a");
 	const char* languageID;
 	LanguageItem* currentItem = NULL;
 	for (int32 i = 0; installedCatalogs.FindString("language", i, &languageID)
 			== B_OK; i++) {
 		BLanguage* language;
-		if (BLocaleRoster::Default()->GetLanguage(languageID, &language)
+		status_t fbpGetLangStatus = BLocaleRoster::Default()->GetLanguage(languageID, &language);
+		if (fbpDebugFile2 != NULL) {
+			fprintf(fbpDebugFile2, "FBP-DEBUG: loop i=%d languageID=%s GetLanguage status=%s\n",
+				(int)i, languageID, strerror(fbpGetLangStatus));
+		}
+		if (fbpGetLangStatus
 				== B_OK) {
 			BString name;
 			language->GetNativeName(name);
+			if (fbpDebugFile2 != NULL) {
+				fprintf(fbpDebugFile2, "FBP-DEBUG: loop i=%d GetNativeName='%s' CountChars=%d\n",
+					(int)i, name.String(), (int)name.CountChars());
+			}

 			// TODO: the following block fails to detect a couple of language
 			// names as containing glyphs we can't render. Why's that?
@@ -475,6 +508,11 @@ BootPromptWindow::_PopulateLanguages()
 		} else
 			fprintf(stderr, "failed to get BLanguage for %s\n", languageID);
 	}
+	if (fbpDebugFile2 != NULL) {
+		fprintf(fbpDebugFile2, "FBP-DEBUG: loop done, fLanguagesListView->CountItems()=%d\n",
+			(int)fLanguagesListView->CountItems());
+		fclose(fbpDebugFile2);
+	}

 	fLanguagesListView->SortItems(compare_void_list_items);
 	if (currentItem != NULL)
