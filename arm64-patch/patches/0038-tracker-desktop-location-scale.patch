 	BTextWidget* fActiveTextWidget;
 
 private:
+	float CurrentLocationScale() const;
+	float SavedLocationRatio();
+
 	mutable uint32 fCachedIconSizeFrom;
 	mutable BSize fCachedIconSize;
+	float fSavedLocationRatio;
+		// < 0 until read; see SavedLocationRatio()
 
 	typedef BView _inherited;
 
