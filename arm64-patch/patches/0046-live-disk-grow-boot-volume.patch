+++ b/src/bin/renku_grow_boot.cpp
@@ -0,0 +1,243 @@
+/*
+ * Copyright 2026, RENKU.
+ * Distributed under the terms of the MIT License.
+ *
+ * renku_grow_boot -- give the RENKU live disk's boot volume the whole disk.
+ *
+ * The live medium is an image with a 300 MiB BFS partition followed by a
+ * small EFI system partition. MacRenkuOS boots it from a qcow2 overlay whose
+ * virtual size is 16 GiB, so everything after the image is empty disk. This
+ * moves the EFI system partition to the end of the disk and stretches the
+ * BFS partition up to it; BFS itself grows into the larger partition the
+ * next time it is mounted (grow_to_partition in the "bfs" driver settings,
+ * written here). Only the partition table and the ESP are touched while the
+ * system runs from the disk: neither is in use.
+ *
+ * Exit status: 0 nothing to do, 2 the disk was changed and the system needs
+ * a restart, 1 error. With --restart (what the login job passes), a change
+ * is followed by a notice and the restart itself.
+ */
+
+
+#include <Drivers.h>
+#include <fs_info.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+
+static const char* kSettingsDir = "/boot/home/config/settings/kernel/drivers";
+static const char* kSettingsFile
+	= "/boot/home/config/settings/kernel/drivers/bfs";
+static const uint32 kSectorSize = 512;
+static const uint32 kAlignment = 2048;
+	// sectors: 1 MiB
+static const uint32 kMinimumGain = 131072;
+	// sectors: below 64 MiB, leave the disk alone
+
+
+struct mbr_entry {
+	uint8	status;
+	uint8	chsFirst[3];
+	uint8	type;
+	uint8	chsLast[3];
+	uint32	start;
+	uint32	count;
+} __attribute__((packed));
+
+
+static uint32
+le32(const uint8* p)
+{
+	return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32)p[3] << 24);
+}
+
+
+static bool
+write_settings()
+{
+	char path[B_PATH_NAME_LENGTH];
+	strlcpy(path, kSettingsDir, sizeof(path));
+	for (char* slash = strchr(path + 1, '/'); slash != NULL;
+			slash = strchr(slash + 1, '/')) {
+		*slash = '\0';
+		mkdir(path, 0755);
+		*slash = '/';
+	}
+	mkdir(path, 0755);
+
+	FILE* file = fopen(kSettingsFile, "w");
+	if (file == NULL)
+		return false;
+	fputs("# Written by renku_grow_boot: BFS grows a volume to fill its\n"
+		"# partition when the partition is larger than the file system.\n"
+		"grow_to_partition true\n", file);
+	fclose(file);
+	return true;
+}
+
+
+static bool
+copy_sectors(int fd, off_t from, off_t to, off_t count)
+{
+	const size_t chunk = 128 * kSectorSize;
+	uint8* buffer = (uint8*)malloc(chunk);
+	uint8* check = (uint8*)malloc(chunk);
+	if (buffer == NULL || check == NULL)
+		return false;
+
+	bool ok = true;
+	for (off_t done = 0; done < count && ok; ) {
+		size_t bytes = chunk;
+		if ((off_t)(bytes / kSectorSize) > count - done)
+			bytes = (count - done) * kSectorSize;
+		off_t source = (from + done) * kSectorSize;
+		off_t target = (to + done) * kSectorSize;
+		ok = read_pos(fd, source, buffer, bytes) == (ssize_t)bytes
+			&& write_pos(fd, target, buffer, bytes) == (ssize_t)bytes
+			&& read_pos(fd, target, check, bytes) == (ssize_t)bytes
+			&& memcmp(buffer, check, bytes) == 0;
+		done += bytes / kSectorSize;
+	}
+	free(buffer);
+	free(check);
+	return ok;
+}
+
+
+static int grow();
+
+
+int
+main(int argc, char** argv)
+{
+	int status = grow();
+	if (status == 2 && argc > 1 && strcmp(argv[1], "--restart") == 0) {
+		system("alert --info \"RenkuOS is giving its disk the whole virtual "
+			"drive. It restarts once to finish.\" \"Restart\"");
+		execl("/bin/shutdown", "shutdown", "-r", (char*)NULL);
+	}
+	return status;
+}
+
+
+static int
+grow()
+{
+	fs_info info;
+	if (fs_stat_dev(dev_for_path("/boot"), &info) != 0) {
+		fprintf(stderr, "renku_grow_boot: cannot stat /boot\n");
+		return 1;
+	}
+
+	// "/dev/disk/usb/0/0/0" -> "/dev/disk/usb/0/0/raw"
+	char raw[B_PATH_NAME_LENGTH];
+	strlcpy(raw, info.device_name, sizeof(raw));
+	char* slash = strrchr(raw, '/');
+	if (slash == NULL || strcmp(slash + 1, "0") != 0) {
+		printf("renku_grow_boot: /boot is not the first partition of a disk "
+			"(%s), nothing to do\n", info.device_name);
+		return 0;
+	}
+	strlcpy(slash + 1, "raw", sizeof(raw) - (slash + 1 - raw));
+
+	int fd = open(raw, O_RDWR);
+	if (fd < 0) {
+		fprintf(stderr, "renku_grow_boot: cannot open %s: %s\n", raw,
+			strerror(errno));
+		return 1;
+	}
+
+	device_geometry geometry;
+	if (ioctl(fd, B_GET_GEOMETRY, &geometry, sizeof(geometry)) != 0
+		|| geometry.bytes_per_sector != kSectorSize) {
+		fprintf(stderr, "renku_grow_boot: unexpected geometry of %s\n", raw);
+		close(fd);
+		return 1;
+	}
+	off_t diskSectors = (off_t)geometry.cylinder_count
+		* geometry.sectors_per_track * geometry.head_count;
+	if (diskSectors > 0xffffffffLL)
+		diskSectors = 0xffffffffLL;
+
+	uint8 sector[kSectorSize];
+	uint8 cd001[6];
+	if (read_pos(fd, 0, sector, sizeof(sector)) != sizeof(sector)
+		|| read_pos(fd, 0x8000, cd001, sizeof(cd001)) != sizeof(cd001)) {
+		fprintf(stderr, "renku_grow_boot: cannot read %s\n", raw);
+		close(fd);
+		return 1;
+	}
+
+	// Only the RENKU live image: a hybrid ISO (ISO 9660 at 32 KiB) whose MBR
+	// has BFS first, the ESP right after it, and nothing else.
+	mbr_entry* entries = (mbr_entry*)(sector + 446);
+	mbr_entry& bfs = entries[0];
+	mbr_entry& esp = entries[1];
+	if (sector[510] != 0x55 || sector[511] != 0xaa
+		|| memcmp(cd001 + 1, "CD001", 5) != 0
+		|| bfs.type != 0xeb || esp.type != 0xef
+		|| entries[2].type != 0 || entries[3].type != 0
+		|| le32((uint8*)&esp.start) != le32((uint8*)&bfs.start)
+			+ le32((uint8*)&bfs.count)) {
+		printf("renku_grow_boot: %s is not the live disk layout, nothing to "
+			"do\n", raw);
+		close(fd);
+		return 0;
+	}
+
+	const uint32 bfsStart = le32((uint8*)&bfs.start);
+	const uint32 espStart = le32((uint8*)&esp.start);
+	const uint32 espCount = le32((uint8*)&esp.count);
+	const uint32 newEspStart
+		= (uint32)((diskSectors - espCount) / kAlignment * kAlignment);
+
+	if (newEspStart <= espStart || newEspStart - espStart < kMinimumGain) {
+		// Already grown, or a disk with no room: make sure BFS will still
+		// fill the partition (a crash after the move, before the setting)
+		if (access(kSettingsFile, F_OK) != 0 && newEspStart > espStart)
+			write_settings();
+		printf("renku_grow_boot: the boot partition already fills %s\n", raw);
+		close(fd);
+		return 0;
+	}
+
+	printf("renku_grow_boot: moving the EFI partition from sector %u to %u, "
+		"growing the boot partition to %u MiB\n", espStart, newEspStart,
+		(unsigned)((uint64)(newEspStart - bfsStart) * kSectorSize >> 20));
+
+	// The settings first: should anything below fail half way, the next
+	// boot of the same layout tries again.
+	if (!write_settings()) {
+		fprintf(stderr, "renku_grow_boot: cannot write %s\n", kSettingsFile);
+		close(fd);
+		return 1;
+	}
+
+	if (!copy_sectors(fd, espStart, newEspStart, espCount)) {
+		fprintf(stderr, "renku_grow_boot: copying the EFI partition failed\n");
+		close(fd);
+		return 1;
+	}
+	ioctl(fd, B_FLUSH_DRIVE_CACHE);
+
+	// little endian on disk, and so is every Haiku target
+	uint32 bfsCount = newEspStart - bfsStart;
+	memcpy(&bfs.count, &bfsCount, 4);
+	memcpy(&esp.start, &newEspStart, 4);
+	if (write_pos(fd, 0, sector, sizeof(sector)) != sizeof(sector)) {
+		fprintf(stderr, "renku_grow_boot: writing the partition table "
+			"failed\n");
+		close(fd);
+		return 1;
+	}
+	ioctl(fd, B_FLUSH_DRIVE_CACHE);
+	close(fd);
+	sync();
+	return 2;
+}
