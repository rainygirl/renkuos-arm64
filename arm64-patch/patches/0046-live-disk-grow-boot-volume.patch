+
+#ifndef FS_SHELL
+/*!	RENKU: makes the file system as large as its partition, at mount time.
+
+	BFS cannot be resized (ResizeVisitor is a stub), and the RENKU live disk is
+	a 300 MiB BFS partition at the start of a 16 GiB virtual disk. Once
+	renku_grow_boot has stretched the partition, this stretches the file
+	system to match, before the journal, the block cache and the allocator
+	are set up -- nothing else has the volume open yet, so there is no
+	running state to keep consistent.
+
+	The block bitmap starts at block 1 and the log follows it directly; BFS
+	treats everything up to the end of the log as reserved (inode checks,
+	the allocator), so the log has to stay where it ends. A larger bitmap
+	therefore takes the first blocks of the log, and the log becomes that
+	much shorter: for 300 MiB to 16 GiB with 2 KiB blocks, 502 of its 2048
+	blocks. Nothing else moves and no block changes hands, so the count of
+	used blocks stays as it is. That is only safe with a clean log (nothing
+	to replay); a dirty log, an unexpected layout, or a log that would end up
+	shorter than 512 blocks leaves the volume as it is.
+
+	The new bitmap blocks are written first -- they overwrite only the old,
+	clean log -- and the superblock last, so an interruption leaves the old
+	volume intact.
+*/
+status_t
+Volume::_GrowToPartition(off_t partitionSize)
+{
+	disk_super_block superBlock = fSuperBlock;
+	const uint32 blockSize = BlockSize();
+	const int32 bitsPerBlock = blockSize * 8;
+	const off_t oldBlocks = superBlock.NumBlocks();
+	const off_t newBlocks = partitionSize >> BlockShift();
+
+	if (newBlocks - oldBlocks < 8192)
+		return B_OK;
+	if (superBlock.LogStart() != superBlock.LogEnd()) {
+		INFORM(("bfs: not growing %s: the log needs replaying first\n",
+			superBlock.name));
+		return B_BUSY;
+	}
+
+	const off_t oldBitmap = divide_roundup(oldBlocks, bitsPerBlock);
+	const off_t newBitmap = divide_roundup(newBlocks, bitsPerBlock);
+	block_run oldLog = superBlock.log_blocks;
+	const off_t logStart = ToBlock(oldLog);
+	const off_t logEnd = logStart + oldLog.Length();
+	const off_t newLogStart = 1 + newBitmap;
+	const off_t newLogLength = logEnd - newLogStart;
+	const off_t groupBlocks = 1LL << AllocationGroupShift();
+	if (logStart != 1 + oldBitmap || newLogLength < 512
+		|| newLogStart / groupBlocks != (logEnd - 1) / groupBlocks) {
+		INFORM(("bfs: not growing %s: unexpected layout\n", superBlock.name));
+		return B_NOT_SUPPORTED;
+	}
+
+	const size_t bitmapBytes = newBitmap * blockSize;
+	uint32* bitmap = (uint32*)malloc(bitmapBytes);
+	if (bitmap == NULL)
+		return B_NO_MEMORY;
+	MemoryDeleter bitmapDeleter(bitmap);
+	memset(bitmap, 0, bitmapBytes);
+
+	const size_t oldBitmapBytes = oldBitmap * blockSize;
+	if (read_pos(fDevice, blockSize, bitmap, oldBitmapBytes)
+			!= (ssize_t)oldBitmapBytes)
+		return B_IO_ERROR;
+
+	// Every block from 0 to the end of the log is already marked used, and
+	// stays used (superblock, bitmap, log). Past the old end nothing is.
+	for (off_t block = oldBlocks; block < newBlocks; block++) {
+		bitmap[block >> 5]
+			&= ~HOST_ENDIAN_TO_BFS_INT32(1UL << (block % 32));
+	}
+
+	// from the old last bitmap block on: the old one again, then what was
+	// the first part of the (clean) log
+	const off_t first = oldBlocks / bitsPerBlock;
+	const size_t bytes = (newBitmap - first) * blockSize;
+	if (write_pos(fDevice, (1 + first) * blockSize,
+			(uint8*)bitmap + first * blockSize, bytes) != (ssize_t)bytes)
+		return B_IO_ERROR;
+	ioctl(fDevice, B_FLUSH_DRIVE_CACHE);
+
+	superBlock.num_blocks = HOST_ENDIAN_TO_BFS_INT64(newBlocks);
+	superBlock.num_ags = HOST_ENDIAN_TO_BFS_INT32(
+		divide_roundup(newBlocks, (int32)groupBlocks));
+	superBlock.log_blocks = ToBlockRun(newLogStart);
+	superBlock.log_blocks.length = HOST_ENDIAN_TO_BFS_INT16(newLogLength);
+	superBlock.log_start = superBlock.log_end
+		= HOST_ENDIAN_TO_BFS_INT64(newLogStart);
+	if (!superBlock.IsValid())
+		return B_BAD_DATA;
+
+	if (write_pos(fDevice, 512, &superBlock, sizeof(disk_super_block))
+			!= sizeof(disk_super_block))
+		return B_IO_ERROR;
+	ioctl(fDevice, B_FLUSH_DRIVE_CACHE);
+	fSuperBlock = superBlock;
+
+	dprintf("bfs: grew \"%s\" from %" B_PRIdOFF " to %" B_PRIdOFF
+		" blocks to fill its partition (log %" B_PRIdOFF " -> %" B_PRIdOFF
+		" blocks)\n", superBlock.name, oldBlocks, newBlocks,
+		logEnd - logStart, newLogLength);
+	return B_OK;
+}
+#endif	// !FS_SHELL
+
 status_t
 Volume::WriteSuperBlock()
 {
