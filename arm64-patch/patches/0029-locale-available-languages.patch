Subject: [PATCH] locale: implement the plaintext catalog add-on's language list

FirstBootPrompt's Language list came up empty even though the catalogs
for it were right there on disk, 32 of them. The only catalog add-on
this build (or any Haiku build -- this isn't arm64 or minimum
specific) has is "plaintext", and BLocaleRoster::GetAvailableCatalogs()
has exactly one implementation to call into: this add-on's
get_available_languages(), which was a stub ("// TODO return B_ERROR").

Implemented it to scan <data>/locale/catalogs/<signature>/*.catalog --
the layout DoCatalogs/LinkApplicationCatalog actually produces and
ships, confirmed by listing it on a booted image. Not the same path
this add-on's own Instantiate() reads (the app's own folder, or the
two legacy BeOS etc/ paths) or the same extension as its own
kCatExtension (".catkeys", the uncompiled source format) -- both of
those are for a different, older use of this add-on, and neither is
how a compiled catalog actually ships.

diff --git a/src/add-ons/locale/catalogs/plaintext/Catalog.cpp b/src/add-ons/locale/catalogs/plaintext/Catalog.cpp
index 276f2e27b6..67bbf55586 100644
--- a/src/add-ons/locale/catalogs/plaintext/Catalog.cpp
+++ b/src/add-ons/locale/catalogs/plaintext/Catalog.cpp
@@ -7,6 +7,7 @@
 
 #include <assert.h>
 #include <cstdio>
+#include <cstring>
 #include <iostream>
 #include <fstream>
 #include <new>
@@ -418,8 +419,73 @@ get_available_languages(BMessage* availableLanguages,
 	const char* sigPattern = NULL, const char* langPattern = NULL,
 	int32 fingerprint = 0)
 {
-	// TODO
-	return B_ERROR;
+	// Compiled catalogs (the kind every app actually ships, built by
+	// DoCatalogs/LinkApplicationCatalog) live under
+	// <data>/locale/catalogs/<signature>/<language>.catalog -- note
+	// ".catalog", not this file's own kCatExtension (".catkeys", the
+	// uncompiled source format PlainTextCatalog::ReadFromFile() edits).
+	// This add-on's own Instantiate() never reads the compiled layout
+	// either -- it only checks the app's own folder and the two legacy
+	// BeOS etc/ paths -- so callers like BLocaleRoster::GetAvailableCatalogs()
+	// (FirstBootPrompt's language list, among others) got nothing back
+	// even though the catalogs were right there on disk.
+	if (availableLanguages == NULL)
+		return B_BAD_VALUE;
+
+	directory_which dataDirs[] = {
+		B_SYSTEM_DATA_DIRECTORY,
+		B_USER_DATA_DIRECTORY
+	};
+
+	status_t result = B_ENTRY_NOT_FOUND;
+	for (size_t i = 0; i < sizeof(dataDirs) / sizeof(dataDirs[0]); i++) {
+		BPath catalogsPath;
+		if (find_directory(dataDirs[i], &catalogsPath) != B_OK)
+			continue;
+		catalogsPath.Append("locale/catalogs");
+
+		BDirectory catalogsDir(catalogsPath.Path());
+		if (catalogsDir.InitCheck() != B_OK)
+			continue;
+
+		BEntry sigEntry;
+		while (catalogsDir.GetNextEntry(&sigEntry) == B_OK) {
+			if (!sigEntry.IsDirectory())
+				continue;
+			char sigName[B_FILE_NAME_LENGTH];
+			if (sigEntry.GetName(sigName) != B_OK)
+				continue;
+			if (sigPattern != NULL && strcmp(sigPattern, sigName) != 0)
+				continue;
+
+			BPath sigPath;
+			if (sigEntry.GetPath(&sigPath) != B_OK)
+				continue;
+			BDirectory sigDir(sigPath.Path());
+			if (sigDir.InitCheck() != B_OK)
+				continue;
+
+			BEntry langEntry;
+			while (sigDir.GetNextEntry(&langEntry) == B_OK) {
+				char langFile[B_FILE_NAME_LENGTH];
+				if (langEntry.GetName(langFile) != B_OK)
+					continue;
+				BString language(langFile);
+				if (!language.EndsWith(".catalog"))
+					continue;
+				language.Truncate(
+					language.Length() - strlen(".catalog"));
+				if (langPattern != NULL && language != langPattern)
+					continue;
+				if (availableLanguages->AddString("language", language)
+						== B_OK) {
+					result = B_OK;
+				}
+			}
+		}
+	}
+
+	return result;
 }
 
 
