resource app_signature "application/x-vnd.RENKU-AppMarket";

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	/* 0 = development	1 = alpha			2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety = 0,

	internal = 0,

	short_info = "R AppMarket",
	long_info  = "R AppMarket -- browse and install RENKU arm64 packages"
};

// A hand-encoded basket (the "market") with a generic app-icon tile
// sitting inside it, peeking out above the rim. Built by
// tools/gen-rappmarket-icon.py directly against Haiku's own HVIF parser
// (src/libs/icon/flat_icon/FlatIconImporter.cpp) rather than from a spec,
// since Haiku ships no bitmap/SVG-to-HVIF tool.
resource vector_icon {
	$"6E63696603014285C3FF01A87A4DFF01D6AF82FF030A0436284A284A3E363E0A"
	$"042A3A563A56442A440A042E4452444C5A345A030A000100000A010101000A02"
	$"010200"
};
