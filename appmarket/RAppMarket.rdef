resource app_signature "application/x-vnd.RENKU-AppMarket";

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	/* 0 = development	1 = alpha			2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety = 0,

	internal = 0,

	short_info = "R AppMarket",
	long_info  = "R AppMarket -- browse and install RENKU arm64 packages"
};

// A hand-encoded BeOS-style diamond (rhombus) basket -- the classic
// isometric-viewed-from-above container shape -- with a generic app tile
// nested inside it. Built by tools/gen-rappmarket-icon.py directly
// against Haiku's own HVIF parser
// (src/libs/icon/flat_icon/FlatIconImporter.cpp) rather than from a spec,
// since Haiku ships no bitmap/SVG-to-HVIF tool.
resource vector_icon {
	$"6E6369660301B28053FF016E4B2DFF014285C3FF030A0440265A40405A26400A"
	$"0440305040405030400A044037494040493740030A000100000A010101000A02"
	$"010200"
};
